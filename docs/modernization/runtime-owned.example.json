{
  "runtime_profile": "owned-codex-v1",
  "model": "gpt-6.1-sol",
  "web_search": "live",
  "codex_binary": "/opt/codex-0.166.0/bin/codex",
  "code_mode_host": "/opt/codex-0.166.0/bin/codex-code-mode-host",
  "token_file": "/home/you/.codex/auth.json",
  "ken_command": "/opt/researcher-tools/ken-rank/bin/ken",
