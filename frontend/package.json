{
  "name": "researcher-frontend",
  "private": true,
  "version": "0.0.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:contracts && npm run test:ui",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:contracts": "node --test tests/*.test.ts",
    "test:ui": "vitest run",
    "test:e2e": "node tests/workspace.e2e.mjs",
    "test:e2e:knowledge": "node tests/knowledge.e2e.mjs",
    "lint": "eslint src tests/ui vite.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "katex": "0.19.1",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query-devtools": "5.107.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "katex": "$katex",
    "minimatch": "11.0.5",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.19.1"
